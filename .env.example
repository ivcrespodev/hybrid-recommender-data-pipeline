# ==============================================================================
# Recommender System Data Pipeline — Environment Configuration Template
# Instructions: Copy this file to '.env' and populate with your values.
#               Never commit the populated .env file to version control.
#
# Pre-provisioned infrastructure (must exist before running setup.sh):
#   - RDS MySQL instance:      recommender-system-rds
#   - Kinesis Data Stream:     recommender-system-kinesis-data-stream
#   - Lambda inference fn:     recommender-system-model-inference
#   - S3 ML artifacts bucket:  see ML_ARTIFACTS_BUCKET below
#   - VPC with two public subnets tagged:
#       Environment=Production, Type=PublicA
#       Environment=Production, Type=PublicB
# ==============================================================================

# AWS Core Configuration
AWS_ACCOUNT_ID="your_aws_account_id"
AWS_REGION="us-east-1"

# S3 ML Artifacts Bucket
# Pre-provisioned by the Data Science team. Contains pre-trained model weights,
# scalers, and embedding CSVs consumed by the vector database ingestion script.
# Naming convention: recommender-system-<AWS_ACCOUNT_ID>-<AWS_REGION>-ml-artifacts
ML_ARTIFACTS_BUCKET="recommender-system-your_aws_account_id-us-east-1-ml-artifacts"

# Source MySQL Database Credentials
# Credentials for the pre-provisioned RDS MySQL instance (classicmodels schema).
DB_SOURCE_USER="your_source_database_user"
DB_SOURCE_PASSWORD="your_source_database_password"
