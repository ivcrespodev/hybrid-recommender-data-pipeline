# ============================================================================
# Recommender System Data Pipeline - Environment Configuration Template
# Instructions: Copy this file to '.env' and populate with your cloud configurations.
# ============================================================================

# Cloud Core Credentials
AWS_ACCOUNT_ID="your_aws_account_id"
AWS_REGION="us-east-1"

# Centralized Enterprise Repositories
ML_ARTIFACTS_BUCKET="recommender-system-your_aws_account_id-us-east-1-ml-artifacts"

# Source Relational Engine (MySQL Operational Store)
DB_SOURCE_USER="your_source_database_admin"
DB_SOURCE_PASSWORD="your_secure_source_database_password"

# Target Analytics Store (PostgreSQL Vector Engine)
VECTOR_DB_HOST="your_vector_db_endpoint"
VECTOR_DB_USER="your_vector_db_admin_user"
VECTOR_DB_PASSWORD="your_secure_vector_db_password"